rules_version = '2';

// Datos de Traduya en Firestore.
service cloud.firestore {
  match /databases/{database}/documents {
    function isRegisteredCaller() {
      // La marca la pone la función confirmRegistration al verificar el código enviado al Gmail
      return request.auth != null && request.auth.token.registered == true;
    }

    // Directorio de números para llamadas por WiFi.
    // Solo quien se registró en la página puede buscar un número, y nadie puede listarlos todos.
    // Solo el teléfono que registró un número (su usuario anónimo) puede cambiarlo o borrarlo.
    match /numbers/{number} {
      function isValidEntry() {
        return request.resource.data.keys().hasOnly(['owner', 'peerId'])
          && request.resource.data.owner == request.auth.uid
          && request.resource.data.peerId is string
          && request.resource.data.peerId.matches('^traduya-[a-z0-9]{16}$');
      }

      allow get: if isRegisteredCaller();
      allow list: if false;
      allow create: if request.auth != null
        && number.matches('^[+][1-9][0-9]{7,14}$')
        && isValidEntry();
      allow update: if request.auth != null
        && resource.data.owner == request.auth.uid
        && isValidEntry();
      allow delete: if request.auth != null
        && resource.data.owner == request.auth.uid;
    }

    // Ficha de quien llama (nombre completo, teléfono y correo). Solo la escriben las funciones;
    // la app de quien recibe la lee para mostrar quién llama.
    match /callers/{uid} {
      allow get: if request.auth != null;
      allow list, write: if false;
    }

    // Códigos de registro pendientes: solo los usan las funciones.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
