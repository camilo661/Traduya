{
  "firestore": {
    "rules": "firebase/firestore.rules"
  },
  "hosting": {
    "public": "web",
    "cleanUrls": true,
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [{ "key": "Cache-Control", "value": "max-age=300" }]
      }
    ]
  },
  "emulators": {
    "auth": { "host": "0.0.0.0", "port": 9099 },
    "firestore": { "host": "0.0.0.0", "port": 8080 },
    "hosting": { "host": "127.0.0.1", "port": 5180 },
    "ui": { "enabled": false }
  }
}
